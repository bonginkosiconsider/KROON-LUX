[debug] [2026-09-01T08:20:37.142Z] <<< [apiv2][body] POST https://firebaserules.googleapis.com/v1/projects/jozi-plug/rulesets {"name":"projects/jozi-plug/rulesets/30fa5435-5b3e-4a35-a12d-130df8043dcf","source":{"files":[{"content":"rules_version = '2';\nservice firebase.storage {\n  match /b/{bucket}/o {\n    function isBootstrapAdmin() {\n      return request.auth != null && (\n        request.auth.token.email == 'kroonluxe@gmail.com' ||\n        request.auth.token.email == 'bonginkosiconsider@gmail.com'\n      );\n    }\n    function isAdmin() {\n      return isBootstrapAdmin() ||\n        (request.auth != null && firestore.get(/databases/(default)/documents/users/$(request.auth.uid)).data.role == 'admin');\n    }\n    match /products/{fileName} { allow read: if true; allow write: if isAdmin() && request.resource.size < 10 * 1024 * 1024 && request.resource.contentType.matches('image/.*'); }\n    match /hero/{fileName} { allow read: if true; allow write: if isAdmin() && request.resource.size < 5 * 1024 * 1024 && request.resource.contentType.matches('image/.*'); }\n    match /brands/{fileName} {\n      allow read: if true;\n      allow create, update: if isAdmin() && request.resource.size < 5 * 1024 * 1024 && request.resource.contentType.matches('image/.*');\n      allow delete: if isAdmin();\n    }\n    match /testimonials/{fileName} {\n      allow read: if true;\n      allow create, update: if isAdmin() && request.resource.size < 5 * 1024 * 1024 && request.resource.contentType.matches('image/(jpeg|png|webp)');\n      allow delete: if isAdmin();\n    }\n  }\n}\n","name":"storage.rules"}]},"createTime":"2026-09-01T08:20:35.925471Z","metadata":{"services":["firebase.storage"]}}

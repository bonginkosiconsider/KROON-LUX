generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserStatus {
  ACTIVE
  SUSPENDED
}

enum AdminRole {
  SUPER_ADMIN
  ADMIN
  MANAGER
  INVENTORY_MANAGER
  MARKETING_MANAGER
  CUSTOMER_SUPPORT
}

enum ProductStatus {
  DRAFT
  ACTIVE
  ARCHIVED
}
enum StockStatus {
  IN_STOCK
  LOW_STOCK
  OUT_OF_STOCK
}
enum OrderStatus {
  PENDING_PAYMENT
  PAID
  PROCESSING
  PACKED
  SHIPPED
  DELIVERED
  CANCELLED
  REFUNDED
  FAILED
}
enum PaymentStatus {
  PENDING
  PAID
  FAILED
  REFUNDED
}

enum CouponType {
  PERCENTAGE
  FIXED_AMOUNT
  FREE_SHIPPING
}

enum CouponScope {
  ORDER
  PRODUCT
  CATEGORY
}

enum PromoterStatus {
  PENDING
  APPROVED
  SUSPENDED
}

enum ReferralAttributionStatus {
  ACTIVE
  CONVERTED
  EXPIRED
  VOID
}

enum CommissionStatus {
  PENDING
  APPROVED
  PAID
  VOID
}

enum NotificationStatus {
  PENDING
  SENT
  FAILED
}

enum OutboxStatus {
  PENDING
  PROCESSING
  SENT
  FAILED
}

model User {
  id           String       @id @default(cuid())
  email        String       @unique
  passwordHash String?
  firstName    String
  lastName     String
  phone        String?
  status       UserStatus   @default(ACTIVE)
  emailVerifiedAt DateTime?
  lastLoginAt  DateTime?
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt
  grants       AdminGrant[]
  sessions     Session[]
  verificationTokens VerificationToken[]
  passwordResetTokens PasswordResetToken[]
  addresses    Address[]
  orders       Order[]
  cart         Cart?
  wishlist     WishlistItem[]
  reviews      Review[]
  promoter     Promoter?
  notifications Notification[]
  couponRedemptions CouponRedemption[]
  referralAttributions ReferralAttribution[]
  @@index([status, createdAt])
}

model AdminGrant {
  id        String   @id @default(cuid())
  userId    String
  role      AdminRole @default(ADMIN)
  enabled   Boolean  @default(true)
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@unique([userId, role])
  @@index([enabled, role])
}

model Session {
  id        String   @id @default(cuid())
  tokenHash String   @unique
  userId    String
  expiresAt DateTime
  ipHash    String?
  userAgent String?
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@index([userId, expiresAt])
}

model VerificationToken {
  id        String   @id @default(cuid())
  userId    String
  tokenHash String   @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@index([userId, expiresAt])
}

model PasswordResetToken {
  id        String   @id @default(cuid())
  userId    String
  tokenHash String   @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@index([userId, expiresAt])
}

model Product {
  id            String          @id @default(cuid())
  name          String
  slug          String          @unique
  shortDescription String?
  description   String?
  brand         String?
  startingPriceCents Int?
  status        ProductStatus   @default(DRAFT)
  featured      Boolean         @default(false)
  newArrival    Boolean         @default(false)
  bestSeller    Boolean         @default(false)
  onSale        Boolean         @default(false)
  videoUrl      String?
  weightGrams   Int?
  dimensions    Json?
  shippingInfo  String?
  seoTitle      String?
  seoDescription String?
  publishedAt   DateTime?
  categoryId    String?
  collectionId  String?
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt
  category      Category?       @relation(fields: [categoryId], references: [id])
  collection    Collection?     @relation(fields: [collectionId], references: [id])
  images        ProductImage[]
  variants      ProductVariant[]
  attributes    ProductAttribute[]
  tags          ProductTag[]
  wishlist      WishlistItem[]
  reviews       Review[]
  orderItems    OrderItem[]
  @@index([status, featured, createdAt])
  @@index([status, newArrival, createdAt])
  @@index([status, bestSeller, createdAt])
  @@index([status, onSale, createdAt])
  @@index([categoryId, status])
  @@index([collectionId, status])
  @@index([status, startingPriceCents])
}

model ProductImage {
  id        String  @id @default(cuid())
  productId String
  url       String
  altText   String
  storageKey String?
  width     Int?
  height    Int?
  mimeType  String?
  primary   Boolean @default(false)
  sortOrder Int     @default(0)
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  @@index([productId, sortOrder])
}

model ProductVariant {
  id             String      @id @default(cuid())
  productId      String
  sku            String      @unique
  barcode        String?
  name           String
  priceInCents   Int
  salePriceCents Int?
  costPriceCents Int?
  stockQuantity  Int         @default(0)
  reservedStock  Int         @default(0)
  lowStockAt     Int         @default(5)
  stockStatus    StockStatus @default(OUT_OF_STOCK)
  attributes     Json
  size           String?
  color          String?
  weightGrams    Int?
  imageUrl       String?
  product        Product     @relation(fields: [productId], references: [id], onDelete: Cascade)
  cartItems      CartItem[]
  orderItems     OrderItem[]
  inventoryLedger InventoryLedger[]
  @@index([productId])
  @@index([stockStatus, stockQuantity])
  @@index([color, size])
}

model ProductAttribute {
  id        String  @id @default(cuid())
  productId String
  name      String
  value     String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  @@unique([productId, name, value])
  @@index([name, value])
}

model Category {
  id          String     @id @default(cuid())
  name        String
  slug        String     @unique
  description String?
  imageUrl    String?
  parentId    String?
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
  parent      Category?  @relation("CategoryTree", fields: [parentId], references: [id], onDelete: SetNull)
  children    Category[] @relation("CategoryTree")
  products    Product[]
  @@index([parentId])
}

model Collection {
  id          String    @id @default(cuid())
  name        String
  slug        String    @unique
  description String?
  imageUrl    String?
  featured    Boolean   @default(false)
  startsAt    DateTime?
  endsAt      DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  products    Product[]
  @@index([featured, startsAt])
}

model ProductTag {
  productId String
  tag       String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  @@id([productId, tag])
  @@index([tag])
}

model InventoryLedger {
  id        String   @id @default(cuid())
  variantId String
  delta     Int
  reason    String
  orderId   String?
  createdAt DateTime @default(now())
  variant   ProductVariant @relation(fields: [variantId], references: [id])
  order     Order?   @relation(fields: [orderId], references: [id])
  @@index([variantId, createdAt])
  @@index([orderId])
}

model Cart {
  id        String     @id @default(cuid())
  userId    String?    @unique
  guestKey  String?    @unique
  couponCode String?
  referralCode String?
  currency  String     @default("ZAR")
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
  user      User?      @relation(fields: [userId], references: [id], onDelete: Cascade)
  items     CartItem[]
}

model CartItem {
  id        String @id @default(cuid())
  cartId    String
  variantId String
  quantity  Int
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  cart      Cart   @relation(fields: [cartId], references: [id], onDelete: Cascade)
  variant   ProductVariant @relation(fields: [variantId], references: [id])
  @@unique([cartId, variantId])
  @@index([variantId])
}

model Address {
  id         String @id @default(cuid())
  userId     String
  label      String
  firstName  String
  lastName   String
  line1      String
  line2      String?
  city       String
  province   String
  postalCode String
  country    String
  phone      String?
  isDefault  Boolean @default(false)
  user       User @relation(fields: [userId], references: [id], onDelete: Cascade)
  orders     Order[]
  @@index([userId, isDefault])
}

model Order {
  id              String          @id @default(cuid())
  orderNumber     String          @unique
  userId          String?
  addressId       String?
  customerEmail   String
  customerFirstName String
  customerLastName String
  customerPhone   String?
  shippingAddress Json
  status          OrderStatus     @default(PENDING_PAYMENT)
  paymentStatus   PaymentStatus   @default(PENDING)
  currency        String          @default("ZAR")
  subtotalCents   Int
  discountCents   Int              @default(0)
  shippingCents   Int              @default(0)
  taxCents        Int              @default(0)
  totalCents      Int
  couponCode      String?
  referralCode    String?
  referralAttributionId String?
  trackingNumber  String?
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  user            User?            @relation(fields: [userId], references: [id])
  address         Address?         @relation(fields: [addressId], references: [id])
  items           OrderItem[]
  payment         Payment?
  commission      ReferralCommission?
  referralAttribution ReferralAttribution? @relation(fields: [referralAttributionId], references: [id])
  couponRedemption CouponRedemption?
  inventoryLedger InventoryLedger[]
  @@index([userId, createdAt])
  @@index([status, createdAt])
  @@index([paymentStatus, createdAt])
  @@index([referralCode, createdAt])
}

model OrderItem {
  id             String @id @default(cuid())
  orderId        String
  productId      String
  variantId      String
  productName    String
  variantName    String
  sku            String
  unitPriceCents Int
  quantity       Int
  imageUrl       String?
  attributes     Json?
  order          Order @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product        Product @relation(fields: [productId], references: [id])
  variant        ProductVariant @relation(fields: [variantId], references: [id])
  @@index([orderId])
  @@index([productId])
  @@index([variantId])
}

model Payment {
  id                String        @id @default(cuid())
  orderId           String        @unique
  provider          String
  providerPaymentId String        @unique
  currency          String        @default("ZAR")
  amountCents       Int
  status            PaymentStatus @default(PENDING)
  rawPayload        Json?
  processedAt       DateTime?
  createdAt         DateTime      @default(now())
  order             Order         @relation(fields: [orderId], references: [id])
  @@index([provider, status, createdAt])
}

model Coupon {
  id                 String      @id @default(cuid())
  code               String      @unique
  type               CouponType
  scope              CouponScope @default(ORDER)
  amount             Int
  usageLimit         Int?
  usageCount         Int         @default(0)
  minimumSpendCents  Int?
  firstOrderOnly     Boolean     @default(false)
  eligibleProductIds String[]    @default([])
  eligibleCategoryIds String[]   @default([])
  startsAt           DateTime?
  expiresAt          DateTime?
  active             Boolean     @default(true)
  createdAt          DateTime    @default(now())
  updatedAt          DateTime    @updatedAt
  redemptions        CouponRedemption[]
  @@index([active, expiresAt])
}

model CouponRedemption {
  id        String @id @default(cuid())
  couponId  String
  orderId   String @unique
  userId    String?
  createdAt DateTime @default(now())
  coupon    Coupon @relation(fields: [couponId], references: [id])
  order     Order  @relation(fields: [orderId], references: [id])
  user      User?  @relation(fields: [userId], references: [id])
  @@index([couponId, createdAt])
  @@index([userId, createdAt])
}

model WishlistItem {
  userId    String
  productId String
  createdAt DateTime @default(now())
  user      User @relation(fields: [userId], references: [id], onDelete: Cascade)
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  @@id([userId, productId])
}

model Review {
  id         String   @id @default(cuid())
  userId     String
  productId  String
  rating     Int
  title      String?
  body       String
  approved   Boolean  @default(false)
  verified   Boolean  @default(false)
  hidden     Boolean  @default(false)
  imageUrls  String[] @default([])
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  user       User @relation(fields: [userId], references: [id], onDelete: Cascade)
  product    Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  @@unique([userId, productId])
  @@index([productId, approved])
}

model Promoter {
  id                 String   @id @default(cuid())
  userId             String   @unique
  code               String   @unique
  status             PromoterStatus @default(PENDING)
  commissionRateBps  Int      @default(1000)
  fixedCommissionCents Int?
  minimumPayoutCents Int      @default(10000)
  attributionDays    Int      @default(30)
  campaignStartAt    DateTime?
  campaignEndAt      DateTime?
  approvedAt         DateTime?
  suspendedAt        DateTime?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
  user               User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  clicks             ReferralClick[]
  attributions       ReferralAttribution[]
  commissions        ReferralCommission[]
  @@index([status, createdAt])
}

model ReferralClick {
  id         String   @id @default(cuid())
  promoterId String
  visitorKey String
  ipHash     String?
  userAgentHash String?
  createdAt  DateTime @default(now())
  promoter   Promoter @relation(fields: [promoterId], references: [id], onDelete: Cascade)
  @@index([promoterId, createdAt])
  @@index([visitorKey, createdAt])
}

model ReferralAttribution {
  id         String   @id @default(cuid())
  promoterId String
  visitorKey String
  referralCode String
  status     ReferralAttributionStatus @default(ACTIVE)
  userId     String?
  orderId    String? @unique
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  convertedAt DateTime?
  promoter   Promoter @relation(fields: [promoterId], references: [id], onDelete: Cascade)
  user       User?    @relation(fields: [userId], references: [id])
  orders     Order[]
  @@index([promoterId, createdAt])
  @@index([visitorKey, status, expiresAt])
  @@index([referralCode, status])
}

model ReferralCommission {
  id          String           @id @default(cuid())
  promoterId  String
  orderId     String           @unique
  status      CommissionStatus @default(PENDING)
  amountCents Int
  notes       String?
  createdAt   DateTime         @default(now())
  approvedAt  DateTime?
  paidAt      DateTime?
  promoter    Promoter         @relation(fields: [promoterId], references: [id])
  order       Order            @relation(fields: [orderId], references: [id])
  @@index([promoterId, status, createdAt])
}

model Notification {
  id        String   @id @default(cuid())
  userId    String
  type      String
  status    NotificationStatus @default(PENDING)
  payload   Json
  sentAt    DateTime?
  failedAt  DateTime?
  createdAt DateTime @default(now())
  user      User @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@index([userId, createdAt])
  @@index([status, createdAt])
}

model OutboxEvent {
  id          String       @id @default(cuid())
  type        String
  payload     Json
  status      OutboxStatus @default(PENDING)
  attempts    Int          @default(0)
  availableAt DateTime     @default(now())
  processedAt DateTime?
  createdAt   DateTime     @default(now())
  @@index([status, availableAt])
}

model AuditLog {
  id        String   @id @default(cuid())
  actorId   String?
  action    String
  entity    String
  entityId  String?
  metadata  Json?
  ipHash    String?
  userAgent String?
  requestId String?
  createdAt DateTime @default(now())
  @@index([actorId, createdAt])
  @@index([entity, entityId])
  @@index([action, createdAt])
}

model StoreSetting {
  key       String   @id
  value     Json
  isSecret  Boolean  @default(false)
  updatedAt DateTime @updatedAt
}

model ShippingMethod {
  id                  String  @id @default(cuid())
  name                String
  code                String  @unique
  description         String?
  baseFeeCents        Int
  freeAboveCents      Int?
  active              Boolean @default(true)
  deliveryWindowDays  String?
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt
  @@index([active, code])
}

rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    function isBootstrapAdmin() {
      return request.auth != null && (
        request.auth.token.email == 'kroonluxe@gmail.com' ||
        request.auth.token.email == 'bonginkosiconsider@gmail.com'
      );
    }
    function isAdmin() {
      return isBootstrapAdmin() ||
        (request.auth != null && firestore.get(/databases/(default)/documents/users/$(request.auth.uid)).data.role == 'admin');
    }
    match /products/{fileName} { allow read: if true; allow write: if isAdmin() && request.resource.size < 10 * 1024 * 1024 && request.resource.contentType.matches('image/.*'); }
    match /hero/{fileName} { allow read: if true; allow write: if isAdmin() && request.resource.size < 5 * 1024 * 1024 && request.resource.contentType.matches('image/.*'); }
  }
}

rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function isBootstrapAdmin() {
      return signedIn() && (
        request.auth.token.email == 'kroonluxe@gmail.com' ||
        request.auth.token.email == 'bonginkosiconsider@gmail.com'
      );
    }
    function isAdmin() {
      return isBootstrapAdmin() ||
        (signedIn() &&
          exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
          get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin');
    }
    function approvedPromoter(promoterId) {
      return promoterId is string &&
        exists(/databases/$(database)/documents/promoters/$(promoterId)) &&
        get(/databases/$(database)/documents/promoters/$(promoterId)).data.status == 'approved';
    }

    match /users/{userId} {
      allow read: if signedIn() && (request.auth.uid == userId || isAdmin());
      allow create: if isAdmin() || (signedIn() && request.auth.uid == userId && request.resource.data.role == 'customer');
      allow update: if isAdmin() || (request.auth.uid == userId && request.resource.data.role == resource.data.role);
      allow delete: if isAdmin();
    }

    match /products/{productId} {
      allow read: if (resource.data.isPublished == true || resource.data.status == 'published' || isAdmin());
      allow create, update, delete: if isAdmin();
    }

    match /conversations/{conversationId} {
      allow create: if true;
      allow update: if !signedIn() || isAdmin();
      allow read, update, delete: if isAdmin();
      match /messages/{messageId} {
        allow create: if true;
        allow read, update, delete: if isAdmin();
      }
    }

    match /productSlugs/{slugId} {
      allow read, write: if isAdmin();
    }

    match /productSkus/{skuId} {
      allow read, write: if isAdmin();
    }

    match /orders/{orderId} {
      allow create: if signedIn() && request.resource.data.customerId == request.auth.uid;
      allow read: if isAdmin() || (signedIn() && resource.data.customerId == request.auth.uid);
      allow update: if isAdmin();
      allow delete: if false;
    }

    match /promoters/{promoterId} {
      allow read: if isAdmin() ||
        resource.data.status == 'approved' ||
        (signedIn() && resource.data.userId == request.auth.uid);
      allow create: if isAdmin() ||
        (signedIn() &&
          promoterId == request.resource.data.code &&
          request.resource.data.userId == request.auth.uid &&
          request.resource.data.status == 'pending' &&
          request.resource.data.discountPercent == 10);
      allow update, delete: if isAdmin();
    }

    match /promoterCodes/{code} {
      allow read: if true;
      allow create: if isAdmin() ||
        (signedIn() &&
          code == request.resource.data.code &&
          request.resource.data.promoterId == code &&
          request.resource.data.status == 'pending');
      allow update, delete: if isAdmin();
    }

    match /referrals/{referralId} {
      allow read: if isAdmin() || (signedIn() && resource.data.customerId == request.auth.uid);
      allow create: if isAdmin() ||
        (approvedPromoter(request.resource.data.promoterId) &&
          request.resource.data.type in ['visit', 'code_entry'] &&
          request.resource.data.status in ['captured', 'authenticated'] &&
          (!('customerId' in request.resource.data) ||
            request.resource.data.customerId == null ||
            (signedIn() && request.resource.data.customerId == request.auth.uid))) ||
        (signedIn() &&
          approvedPromoter(request.resource.data.promoterId) &&
          request.resource.data.customerId == request.auth.uid &&
          request.resource.data.type == 'checkout' &&
          request.resource.data.status == 'converted');
      allow update, delete: if isAdmin();
    }
    match /settings/{settingId} { allow read: if true; allow write: if isAdmin(); }
    match /shippingZones/{zoneId} { allow read, write: if isAdmin(); }
    match /taxRates/{rateId} { allow read, write: if isAdmin(); }
    match /returns/{returnId} { allow read, write: if isAdmin(); }
    match /payouts/{payoutId} { allow read, write: if isAdmin(); }
    match /categories/{categoryId} { allow read: if true; allow write: if isAdmin(); }
    match /brands/{brandId} { allow read: if true; allow write: if isAdmin(); }
    match /collections/{collectionId} { allow read: if true; allow write: if isAdmin(); }
    match /testimonials/{testimonialId} { allow read: if true; allow write: if isAdmin(); }
    match /pages/{pageId} {
      allow read: if (resource.data.status == 'published' || resource.data.isPublished == true || isAdmin());
      allow write: if isAdmin();
    }
    match /newsletterSubscribers/{subscriberId} {
      allow create: if request.resource.data.email is string && request.resource.data.email.size() <= 320;
      allow read, update, delete: if isAdmin();
    }
  }
}
